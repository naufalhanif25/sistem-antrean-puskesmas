generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id       Int     @id @default(autoincrement())
  nip      String  @unique
  password String
  role     Role
  cluster  Int?
  nama     String?
}

model Antrean {
  id           Int      @id @default(autoincrement())
  nik          String   @unique
  namaLengkap  String
  jenisKelamin String
  kodeRuangan  String
  nomorAntrean Int
  createdAt    DateTime @default(now())
  status       String   @default("Menunggu")
}

model Counter {
  id          Int    @id @default(autoincrement())
  kodeRuangan String @unique
  lastNumber  Int
}

enum Role {
  ADMIN
  DOKTER
  LAYAR
}
